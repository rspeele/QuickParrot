<Window x:Class="QuickParrot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickParrot.App"
        Title="QuickParrot" Height="640" Width="760" MinWidth="520" MinHeight="420"
        Closing="MainWindow_Closing" Deactivated="MainWindow_Deactivated" Activated="MainWindow_Activated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status.Display}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />

        <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="Library">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Choose library…" Padding="8,2" Click="ChooseLibrary_Click" />
                        <TextBlock Text="{Binding Library.RootDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Left" Content="Up" Padding="8,2" IsEnabled="{Binding Library.CanGoUp}" Click="Up_Click" />
                        <Button DockPanel.Dock="Right" Content="Stop" Padding="12,2" Click="Stop_Click" />
                        <Button DockPanel.Dock="Right" Content="Open in Explorer" Padding="8,2" Margin="0,0,6,0"
                                IsEnabled="{Binding Library.CanOpenInExplorer}" Click="OpenInExplorer_Click" />
                        <TextBlock Text="{Binding Library.CurrentPath}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding Library.Warning}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Foreground="OrangeRed" Visibility="{Binding Library.HasWarning, Converter={StaticResource BoolToVisibility}}" />

                    <GroupBox DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <GroupBox.Header>
                            <TextBlock Text="{Binding PendingGrabs.Count, StringFormat={}Pending grabs ({0})}" />
                        </GroupBox.Header>
                        <DockPanel Margin="8" Height="140">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Left" Content="Grab now" Padding="8,2" Click="GrabNow_Click" />
                                <TextBlock Text="{Binding PendingGrabs.BufferStatus}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="Gray" />
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button Content="Open" Padding="8,2" Margin="0,0,0,4" Click="OpenGrab_Click" />
                                <Button Content="Delete" Padding="8,2" Click="DeleteGrab_Click" />
                            </StackPanel>
                            <ListBox x:Name="PendingGrabsList" ItemsSource="{Binding PendingGrabs.Grabs}" DisplayMemberPath="Display"
                                     MouseDoubleClick="PendingGrabs_MouseDoubleClick" />
                        </DockPanel>
                    </GroupBox>

                    <GroupBox DockPanel.Dock="Right" Header="Favorites (chord+F1–F12)" Margin="8,0,0,0" Width="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Favorites.Rows}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding KeyName}" Width="30" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right" Content="Clear" Padding="4,0" Margin="4,0,0,0"
                                                    IsEnabled="{Binding HasClip}" Click="ClearFavorite_Click" />
                                            <Button DockPanel.Dock="Right" Content="Play" Padding="4,0" Margin="4,0,0,0"
                                                    IsEnabled="{Binding HasClip}" Click="PlayFavorite_Click" />
                                            <TextBlock x:Name="Name" Text="{Binding Text}" ToolTip="{Binding Text}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasClip}" Value="False">
                                                <Setter TargetName="Name" Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="Name" Property="Foreground" Value="OrangeRed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>

                    <ListBox x:Name="EntryList" ItemsSource="{Binding Library.Entries}" DisplayMemberPath="Display"
                             MouseDoubleClick="Entries_MouseDoubleClick" KeyDown="Entries_KeyDown"
                             ContextMenuOpening="Entries_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Assign to" ItemsSource="{Binding Favorites.Rows}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding MenuHeader}" />
                                            <EventSetter Event="Click" Handler="AssignFavorite_Click" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <GroupBox Header="Audio devices" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Cable:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" ItemsSource="{Binding Devices.CableChoices}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Devices.SelectedCableId}" />
                                <Slider Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,0,8,4"
                                        Value="{Binding Devices.CableVolume}" ToolTip="Cable volume" />

                                <TextBlock Grid.Row="1" Text="Monitor:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,4" ItemsSource="{Binding Devices.MonitorChoices}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Devices.SelectedMonitorId}" />
                                <Slider Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,0,8,4"
                                        Value="{Binding Devices.MonitorVolume}" ToolTip="Monitor volume" />

                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Content="Refresh" Padding="8,2" Margin="0,0,0,4"
                                        Click="Refresh_Click" />

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding Devices.DeviceStatus}" TextWrapping="Wrap" Foreground="Gray" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Hotkeys" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="Chord key:" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Hotkeys.ChordKeyDisplay}" Margin="4,0,12,0"
                                               VerticalAlignment="Center" FontWeight="Bold" />
                                    <Button DockPanel.Dock="Left" Content="Change…" Padding="8,2" Margin="0,0,16,0" Click="ChangeChordKey_Click" />
                                    <CheckBox Content="Hotkeys enabled" VerticalAlignment="Center" IsChecked="{Binding Settings.HotkeysEnabled}"
                                              ToolTip="Turn off and on again to reinstall the keyboard hook if hotkeys stop responding." />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="Folders with 9 or fewer items:" VerticalAlignment="Center" />
                                    <ComboBox DockPanel.Dock="Left" Width="80" Margin="4,0,0,0"
                                              ItemsSource="{Binding Settings.SmallFolderLayoutChoices}" SelectedItem="{Binding Settings.SmallFolderLayout}" />
                                </DockPanel>

                                <CheckBox Content="Play favorites with plain F-keys (no chord) in fullscreen games"
                                          IsChecked="{Binding Favorites.PlayWithoutChord}" />
                                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="20,2,0,0"
                                           Text="Only F-keys with a clip, and only while a fullscreen or borderless window has focus, so F5 and F2 keep working elsewhere." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Push-to-talk" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <CheckBox Content="Hold push-to-talk while clips play" Margin="0,0,0,8"
                                          IsChecked="{Binding Settings.PushToTalkEnabled}" />

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="Binding:" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Hotkeys.PushToTalkBindingDisplay}" Margin="4,0,12,0"
                                               VerticalAlignment="Center" FontWeight="Bold" />
                                    <Button DockPanel.Dock="Left" Content="Set key…" Padding="8,2" Margin="0,0,12,0"
                                            Click="ChangePushToTalkKey_Click" />
                                    <TextBlock DockPanel.Dock="Left" Text="or mouse:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox DockPanel.Dock="Left" Width="120" ItemsSource="{Binding Hotkeys.PushToTalkMouseButtonChoices}"
                                              DisplayMemberPath="Label" SelectedValuePath="Button"
                                              SelectedValue="{Binding Hotkeys.SelectedPushToTalkMouseButton}" />
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Pre-roll (ms):" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="5000" Margin="0,0,8,4"
                                            VerticalAlignment="Center" Value="{Binding Settings.PreRollMilliseconds}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Settings.PreRollMilliseconds}" VerticalAlignment="Center" Margin="0,0,0,4" />

                                    <TextBlock Grid.Row="1" Text="Post-roll (ms):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="5000" Margin="0,0,8,0"
                                            VerticalAlignment="Center" Value="{Binding Settings.PostRollMilliseconds}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Settings.PostRollMilliseconds}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Mic while clips play" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,0,8,4"
                                          ItemsSource="{Binding Settings.MicDuckModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Mode"
                                          SelectedValue="{Binding Settings.MicDuckMode}" />

                                <TextBlock Grid.Row="1" Text="Turn down to:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Margin="0,0,8,4" VerticalAlignment="Center"
                                        IsEnabled="{Binding Settings.IsMicAttenuationEnabled}" Value="{Binding Settings.MicAttenuationPercent}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,0,4" VerticalAlignment="Center"
                                           Text="{Binding Settings.MicAttenuationPercent, StringFormat={}{0}%}" />

                                <TextBlock Grid.Row="2" Text="Microphone:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Devices.MicDeviceChoices}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Devices.SelectedMicDeviceId}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Instant replay" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <CheckBox Content="Keep a replay buffer for instant-replay grabs" Margin="0,0,0,8"
                                          IsChecked="{Binding Settings.ReplayBufferEnabled}" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Buffer length (s):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider Grid.Column="1" Minimum="5" Maximum="120" VerticalAlignment="Center"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding Settings.ReplayBufferEnabled}" Value="{Binding Settings.ReplayBufferSeconds, Delay=300}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.ReplayBufferSeconds}" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                                           Text="Records what you hear (including voice chat) into memory only; nothing is saved until you grab." />

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="Grab hotkey:" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Hotkeys.GrabHotkeyDisplay}" Margin="4,0,0,0"
                                               VerticalAlignment="Center" FontWeight="Bold" />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="AI clip naming (LiteLLM)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Base URL:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                         Text="{Binding LiteLlm.BaseUrl, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="1" Text="API key:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LiteLlm.ApiKeyPlaceholder}" Foreground="Gray"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="Clear key" Padding="6,1" Margin="8,0,0,0"
                                            Click="ClearApiKey_Click" />
                                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"
                                                 LostFocus="ApiKeyBox_LostFocus" PreviewKeyDown="ApiKeyBox_PreviewKeyDown" />
                                </DockPanel>

                                <TextBlock Grid.Row="2" Text="Transcription model:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                         Text="{Binding LiteLlm.TranscriptionModel, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="3" Text="Chat model:" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                         Text="{Binding LiteLlm.ChatModel, UpdateSourceTrigger=LostFocus}" />

                                <DockPanel Grid.Row="4" Grid.Column="1">
                                    <Button DockPanel.Dock="Left" Content="{Binding LiteLlm.TestConnectionLabel}" Padding="8,2"
                                            IsEnabled="{Binding LiteLlm.CanTestConnection}" Click="TestLiteLlmConnection_Click" />
                                    <TextBlock Text="{Binding LiteLlm.ConnectionTestResult}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DiagnosticsTab" Header="Diagnostics" DataContext="{Binding Diagnostics}">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Re-check" Padding="12,2" IsEnabled="{Binding IsIdle}"
                                Click="Recheck_Click" />
                        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding RepairMessage}" Margin="0,0,0,8" TextWrapping="Wrap"
                               FontStyle="Italic" Visibility="{Binding HasRepairMessage, Converter={StaticResource BoolToVisibility}}" />

                    <GroupBox DockPanel.Dock="Bottom" Header="Test" Margin="0,8,0,0"
                              DataContext="{Binding Test}">
                        <StackPanel Margin="8">
                            <TextBlock Text="{x:Static local:LoopbackTestViewModel.Note}" Foreground="Gray"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />

                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Left" Content="{Binding ButtonLabel}" Padding="12,2"
                                        IsEnabled="{Binding CanRun}" Click="RunLoopbackTest_Click" />
                                <TextBlock Text="{Binding Progress}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Report.Headline}" FontSize="16" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C62828" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result.Verdict}" Value="Passed">
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.Verdict}" Value="VoiceMissing">
                                                    <Setter Property="Foreground" Value="#EF6C00" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.Verdict}" Value="TestSoundMissing">
                                                    <Setter Property="Foreground" Value="#EF6C00" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Report.Details}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Report.Advice}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat={}• {0}}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <Border DockPanel.Dock="Top" Padding="12" Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="1"
                            CornerRadius="4" Visibility="{Binding IsAllGood, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✔ Everything looks good." Foreground="#2E7D32" FontWeight="SemiBold" />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Margin="0,0,0,8" Padding="10" BorderThickness="3,1,1,1" CornerRadius="4"
                                            BorderBrush="#1565C0" Background="#F5F9FF">
                                        <DockPanel>
                                            <TextBlock x:Name="Icon" DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18" Margin="0,0,10,0" Foreground="#1565C0" />
                                            <Button DockPanel.Dock="Right" Content="{Binding FixLabel}" Padding="10,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Top" Click="Fix_Click"
                                                    IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#C62828" />
                                            <Setter TargetName="Card" Property="Background" Value="#FFF5F5" />
                                            <Setter TargetName="Icon" Property="Text" Value="&#xEA39;" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#EF6C00" />
                                            <Setter TargetName="Card" Property="Background" Value="#FFF8F0" />
                                            <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="#EF6C00" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
