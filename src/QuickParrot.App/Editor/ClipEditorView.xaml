<UserControl x:Class="QuickParrot.App.Editor.ClipEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:QuickParrot.App.Editor"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,16,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinWidth" Value="64" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Zoom to selection" Margin="0,0,6,0" Click="ZoomToSelection_Click" />
                <Button Content="Show all" Click="ShowAll_Click" />
            </StackPanel>
            <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Label}"
                       ToolTip="Drag to select. Drag the edges to adjust. Click to place the cursor. Wheel zooms; Shift+wheel scrolls." />
        </DockPanel>

        <!-- Save row -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Status}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Discard capture" Margin="0,0,6,0" Click="Discard_Click"
                        ToolTip="Throw this capture away. Clips you've saved are kept." />
                <Button Content="Done" Click="Done_Click" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,10,6" />
                <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,6,6" Padding="2,2" VerticalContentAlignment="Center"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Margin="0,0,0,6" Content="{Binding SuggestButtonText}" IsEnabled="{Binding CanSuggestName}"
                        Visibility="{Binding HasNamer, Converter={StaticResource BoolToVisibility}}" Click="SuggestName_Click" />

                <TextBlock Grid.Row="1" Text="Folder" Style="{StaticResource Label}" Margin="0,0,10,6" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,6,6" ItemsSource="{Binding Folders}"
                          DisplayMemberPath="Display" SelectedItem="{Binding SelectedFolder}" />

                <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Normalize}">
                    <TextBlock>
                        <Run Text="{Binding NormalizeLabel, Mode=OneWay}" />
                        <Run Text="   " />
                        <Run Text="{Binding LoudnessText, Mode=OneWay}"
                             Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </TextBlock>
                </CheckBox>
                <Button Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Content="Save clip" FontWeight="SemiBold" MinWidth="96"
                        VerticalAlignment="Stretch" Margin="0,0,0,0" IsEnabled="{Binding CanSave}" Click="Save_Click"
                        ToolTip="Save the selection to the library (Enter). The editor stays open for more bites." />
            </Grid>
        </Border>

        <!-- Transport and selection readouts -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="▶  Play selection" Margin="0,0,6,0" Click="PlaySelection_Click" ToolTip="Space" />
                <Button Content="▶  From cursor" Margin="0,0,6,0" Click="PlayFromCursor_Click" />
                <Button Content="■  Stop" Margin="0,0,16,0" Click="Stop_Click" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Select all" Click="SelectAll_Click" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Start" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding SelectionStartText}" Style="{StaticResource Readout}" />
                <TextBlock Text="End" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding SelectionEndText}" Style="{StaticResource Readout}" />
                <TextBlock Text="Length" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding SelectionLengthText}" Style="{StaticResource Readout}" FontWeight="Bold" />
            </StackPanel>
        </DockPanel>

        <ScrollBar DockPanel.Dock="Bottom" Orientation="Horizontal" Minimum="0" SmallChange="1"
                   Maximum="{Binding ScrollMaximum, ElementName=Wave}"
                   ViewportSize="{Binding VisibleFrames, ElementName=Wave}"
                   LargeChange="{Binding VisibleFrames, ElementName=Wave}"
                   Value="{Binding ScrollValue, ElementName=Wave, Mode=TwoWay}" />

        <Border BorderThickness="1" BorderBrush="#FF2E3440" MinHeight="140">
            <editor:WaveformView x:Name="Wave" Peaks="{Binding Peaks}" SampleRate="{Binding SampleRate}"
                                 MinSelectionFrames="{Binding MinSelectionFrames}" Selection="{Binding Selection}"
                                 CursorFrame="{Binding CursorFrame}" PlayheadFrame="{Binding PlayheadFrame}"
                                 SelectionCommitted="Wave_SelectionCommitted" />
        </Border>
    </DockPanel>
</UserControl>
