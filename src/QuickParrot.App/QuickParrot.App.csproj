<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 wants WinForms' SetHighDpiMode instead of manifest DPI awareness, but this is a WPF app;
         UseWindowsForms is only here for the overlay. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickParrot.Audio\QuickParrot.Audio.csproj" />
    <ProjectReference Include="..\QuickParrot.Core\QuickParrot.Core.csproj" />
    <ProjectReference Include="..\QuickParrot.Input\QuickParrot.Input.csproj" />
    <ProjectReference Include="..\QuickParrot.Overlay\QuickParrot.Overlay.csproj" />
  </ItemGroup>

</Project>
